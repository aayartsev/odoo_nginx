# Формат (одна строка = один сайт):
# domain;email;upstream_host;http_port;longpolling_port
#
# email можно оставить пустым — возьмётся CERTBOT_EMAIL из .env
# upstream_host — имя контейнера/сервиса в Docker-сети odoo-net

erp.example.com;you@example.com;odoo;8069;8072
erp-dev.example.com;you@example.com;odoo-dev;8070;8073
