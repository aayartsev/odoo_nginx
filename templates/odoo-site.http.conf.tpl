# GENERATED by generate-sites.sh — do not edit by hand
# site: ${DOMAIN} → ${UPSTREAM}:${HTTP_PORT} / ${CHAT_PORT}
# mode: http (no certificate yet)

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /websocket {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $odoo_chat ${UPSTREAM}:${CHAT_PORT};
        proxy_pass http://$odoo_chat;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;
    }

    location /longpolling {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $odoo_chat ${UPSTREAM}:${CHAT_PORT};
        proxy_pass http://$odoo_chat;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;
    }

    location / {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $odoo_upstream ${UPSTREAM}:${HTTP_PORT};
        proxy_redirect off;
        proxy_pass http://$odoo_upstream;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;
        proxy_read_timeout 720s;
        client_max_body_size 200m;
    }
}
